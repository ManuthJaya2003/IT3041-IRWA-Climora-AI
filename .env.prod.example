# Copy this file to .env.prod on the deployment host.
# Keep the real file out of Git.

PUBLIC_ORIGIN=https://climora.example.com
HTTP_PORT=80
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-a-long-random-application-secret
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# AWS Bedrock (recommended production LLM provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Optional fallbacks and integrations
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
