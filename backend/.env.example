# =============================================================================
# Climora AI - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- App Settings ---
APP_NAME=Climora AI
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- AWS Bedrock (LLM) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# --- Vector Store (ChromaDB - runs locally, no config needed) ---
VECTOR_STORE_COLLECTION=climora-climate-data

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climora

# --- Security ---
SECRET_KEY=change-this-to-a-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- MCP Configuration ---
MCP_SERVER_HOST=localhost
MCP_SERVER_BASE_PORT=8100
