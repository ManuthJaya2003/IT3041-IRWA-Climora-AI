# =============================================================================
# Climora AI - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- App Settings ---
APP_NAME=Climora AI
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- AWS Bedrock (LLM - use when access is approved) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=your-session-token-if-using-temporary-credentials
AWS_REGION=us-east-1
# Use a Bedrock inference profile ID for Claude models.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Google Gemini (free tier - use for development) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_ID=gemini-3.6-flash

# --- Weather APIs ---
OPENWEATHER_API_KEY=your_actual_openweather_api_key_here

# --- Stripe test payments (server-side only) ---
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret

# --- Web Push severe-weather alerts ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
ALERT_POLL_INTERVAL_SECONDS=900

# --- Vector Store (ChromaDB - runs locally, no config needed) ---
VECTOR_STORE_COLLECTION=climora-climate-data

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/climora

# --- Security ---
SECRET_KEY=change-this-to-a-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Token for protected vector endpoints (POST/DELETE /vectors/*), sent as X-Admin-Token header.
# Leave empty for local development (endpoints stay open with a startup warning).
ADMIN_TOKEN=

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- MCP Configuration ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_BASE_PORT=8100